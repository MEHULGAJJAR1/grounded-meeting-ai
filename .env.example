# python scripts/run.py creates .env and generates secrets on first run.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# auto: OpenAI when configured; otherwise transparent local extractive mode.
# openai: require a key; fail closed rather than silently switching providers.
AI_PROVIDER=auto
OPENAI_TIMEOUT_SECONDS=90
DATABASE_URL=sqlite:///./data/grounded.db
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=120
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
MAX_TRANSCRIPT_CHARS=150000
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
ALLOW_DEMO_DATA=true
LOG_LEVEL=INFO
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
POSTGRES_USER=grounded
POSTGRES_DB=grounded
POSTGRES_PASSWORD=
